ESPN_LEAGUE_ID=your_league_id
ESPN_SEASON=2026
ESPN_SWID=your_swid_cookie
ESPN_S2=your_espn_s2_cookie

# Development only. Enables endpoints that use the credentials above.
ESPN_ENABLE_LOCAL_API=false

# Owner-only access (Docker enforces authentication).
FANTASY_AUTH_ENABLED=true
FANTASY_PUBLIC_URL=https://ffa.stefanb.me
FANTASY_TAILSCALE_URL=http://100.94.147.92:8090
# Only for localhost development over HTTP; never enable on the public server.
FANTASY_INSECURE_LOCAL_DEV=false
# Native defaults; Docker stores accounts beside history and keys in another volume.
FANTASY_ACCOUNT_PATH=data/accounts.sqlite3
FANTASY_ENCRYPTION_KEY_PATH=data/secrets/credentials.key

# Automatic pregame captures and next-day results syncing while the API runs.
FANTASY_AUTOMATION_ENABLED=true
# Warm current-week league/player projections on startup and every 30 minutes.
FANTASY_PRECOMPUTE_ENABLED=true
